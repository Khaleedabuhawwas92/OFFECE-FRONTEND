{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "server": "cd server && node server.js",
    "build": "vite build",
    "electron-dev": "concurrently -k \"npm run server\" \"npm run dev\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4000 && npm run electron\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
